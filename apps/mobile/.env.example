# Mobile app — copy to apps/mobile/.env. Only PUBLIC values belong here: they are bundled into the app.
# Do NOT add the Supabase service-role key or any Razorpay secret.

# API base URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_SUPPORT_PHONE=

# Needed for remote push notifications (create with `eas init`). Push does not work in Expo Go.
EXPO_PUBLIC_EAS_PROJECT_ID=
