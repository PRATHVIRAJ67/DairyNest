# ===== API (services/api) — copy to .env in the repo root. Placeholders only, never commit real values =====
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated allowed origins. Must be set explicitly in production.
CORS_ORIGINS=*

# Supabase project (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
# Server only. Needed just to delete the auth user on account deletion. NEVER put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Project Settings > Database > Connection string, "Transaction pooler" recommended).
# The API connects with a privileged role and enforces ownership itself, so keep this secret.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Razorpay TEST mode keys (Dashboard > Account & Settings > API keys). Leave empty until you have an approved account;
# checkout then returns PAYMENT_NOT_CONFIGURED instead of pretending to work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same value in Dashboard > Webhooks (secret field).
RAZORPAY_WEBHOOK_SECRET=

# Optional: raises Expo push rate limits / enables enhanced security. Not required for basic push.
EXPO_ACCESS_TOKEN=
